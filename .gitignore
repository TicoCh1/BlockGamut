# Publish only the website source, bundled assets and build/deployment support.
# Local files remain on disk; new files are private unless explicitly allowed.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/src/
!/public/
!/media/
/media/*
!/media/screenshots/
/media/screenshots/*
!/media/screenshots/*.jpg
!/licenses/
!/scripts/
/scripts/*
!/scripts/glass-geometry.mjs
!/scripts/serve.mjs
!/vendor/
/vendor/*
!/vendor/form-glass-react-0.1.0-runtime.tgz
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml

# Defense in depth for private files inside otherwise allowed directories.
node_modules/
dist/
.npm-cache/
artifacts/
portable/
docs/
tests/
.agents/
.codex/
.aws/
.vscode/
.idea/
.env
.env.*
*.local
*.log
*.map
*.pem
*.key
*.pfx
*.p12
*credentials*
*secret*
*personal*
*private*
AGENTS.md
README*
!/README.md
DEVELOPMENT*
__pycache__/
*.pyc
Thumbs.db
.DS_Store
